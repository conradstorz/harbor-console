[Unit]
Description=Harbor Console dashboard
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/harbor-console/.venv/bin/harbor-console
Restart=always
RestartSec=2
User=harbor
Group=harbor
SupplementaryGroups=docker
NoNewPrivileges=yes
# read-only, not yes: `yes` replaces /home with an empty tmpfs inside this
# unit's mount namespace, and the storage collector reports the mounts the
# *service* sees. On hpz440 that silently hid /home/arm/media -- 2.4 TiB, the
# largest filesystem on the host and the reason the collector exists -- because
# the volume simply was not mounted from the process's point of view. Nothing
# failed and no row appeared. read-only keeps /home unwritable, which is all
# this process ever needed: it reads statvfs and never writes there.
ProtectHome=read-only
PrivateTmp=yes
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux

[Install]
WantedBy=multi-user.target
