[Unit]
Description=Harbor Console web status page
After=tailscaled.service network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/harbor-console/.venv/bin/harbor-console-web
Restart=always
RestartSec=2
User=harbor
Group=harbor
SupplementaryGroups=docker
# The page needs no capability at all now that it binds 8100 (the edge is
# what binds 80/443 and holds CAP_NET_BIND_SERVICE).
CapabilityBoundingSet=
NoNewPrivileges=yes
# read-only, not yes: `yes` replaces /home with an empty tmpfs inside this
# unit's mount namespace, and the storage collector reports the mounts the
# *service* sees. On hpz440 that silently hid /home/arm/media -- 2.4 TiB, the
# largest filesystem on the host and the reason the collector exists -- because
# the volume simply was not mounted from the process's point of view. Nothing
# failed and no row appeared. read-only keeps /home unwritable, which is all
# this process ever needed: it reads statvfs and never writes there.
ProtectHome=read-only
PrivateTmp=yes
# /run/harbor-console, owned by harbor: where the prober writes the
# verdict file the tty1 console and harbor-console-check read. Preserved
# across restarts so a deploy does not blank the console's banner for the
# first cycle; staleness (90 s) is what retires an old verdict, not the
# service stopping.
RuntimeDirectory=harbor-console
RuntimeDirectoryPreserve=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
