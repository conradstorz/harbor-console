[Unit]
Description=Harbor Console web status page
After=tailscaled.service network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/harbor-console/.venv/bin/harbor-console-web
Restart=always
RestartSec=2
User=harbor
Group=harbor
SupplementaryGroups=docker
# The page needs no capability at all now that it binds 8100 (the edge is
# what binds 80/443 and holds CAP_NET_BIND_SERVICE).
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
